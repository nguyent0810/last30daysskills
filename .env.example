# Neon Postgres (pooled URL recommended; same value on Vercel + Railway worker)
DATABASE_URL=

# Required on Vercel / Next.js only — signed anonymous session cookies (min 16 chars). Not used by the Railway worker.
SESSION_SECRET=

# Optional: worker poll interval (ms)
# WORKER_POLL_MS=3000

# Reddit (Railway worker): public search.json frequently returns 403 from datacenter IPs. Set a unique UA with a real contact/project URL.
# REDDIT_USER_AGENT=mycompany-research/1.0 (+https://example.com/contact)
# Optional: skip Reddit entirely (job still succeeds if HN or Polymarket returned data)
# REDDIT_DISABLED=1

# Optional (Railway worker only): polish the final markdown report via OpenAI. If unset or on API failure, the deterministic report is stored unchanged.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional (Vercel / Next.js only): transient Gemini summary on job page — not stored; not used by worker.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Optional (Vercel / Next.js only): thread-page AI compression — deploy-time provider only (`hf` or `gemini`), no fallback chain.
# AI_SUMMARY_PROVIDER=gemini
# If hf: set both HUGGINGFACE_API_TOKEN and HUGGINGFACE_MODEL (Inference API model id).
# HUGGINGFACE_API_TOKEN=
# HUGGINGFACE_MODEL=
# If gemini: set both GEMINI_API_KEY and GEMINI_MODEL (same vars as job-page summary).

# Optional: GitHub PAT for `git push` from this machine only (never commit)
# GITHUB_TOKEN=
