# Neon Postgres (pooled URL recommended; same value on Vercel + Railway worker)
DATABASE_URL=

# Required on Vercel / Next.js only — signed anonymous session cookies (min 16 chars). Not used by the Railway worker.
SESSION_SECRET=

# Optional: worker poll interval (ms)
# WORKER_POLL_MS=3000

# Optional (Railway worker only): polish the final markdown report via OpenAI. If unset or on API failure, the deterministic report is stored unchanged.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: GitHub PAT for `git push` from this machine only (never commit)
# GITHUB_TOKEN=
